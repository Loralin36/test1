# demo.session — 命令脚本回放（对应作业文档第 6 节“典型会话”）
# 用 `npm run demo` 或 `npx tsx src/main.ts demo.session` 运行
init 800 600
create rect bg 0 0 800 600 #ffffff
create text title 20 40 "My Diagram"
create circle c1 100 100 20 red
create rect box 200 80 60 60 #3366ff
group markers c1 box
tree
move c1 30 0
undo
redo
set title text "My Diagram v2"
undo
group bad c1 markers
delete box
undo
save demo.svg
# —— 扩展演示：覆盖作业第 6 节之外的其余已实现命令 ——
scale c1 2
show c1
front c1
back bg
create rect r2 10 10 50 50 #00ff00
addto markers r2
tree
ungroup markers
tree
canvas 1000 800
canvas
tree
read sample.svg
tree
